rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auxiliar: Verifica se o usuário está autenticado
    function isAuthed() {
      return request.auth != null;
    }

    // Auxiliar: Verifica se o documento pertence ao usuário autenticado
    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    // --- 1. COLEÇÃO DE USUÁRIOS (users) ---
    match /users/{userId} {
      // Qualquer um pode ver perfis para navegar no feed
      allow read: if isAuthed();
      // Apenas o próprio usuário pode criar ou modificar seu perfil
      allow create, update: if isOwner(userId);
      // Ninguém pode excluir a conta sem validação extra
      allow delete: if isOwner(userId);
    }

    // --- 2. COLEÇÃO DE POSTS (posts) ---
    match /posts/{postId} {
      // Qualquer usuário conectado pode ver posts no feed
      allow read: if isAuthed();
      
      // Regra de segurança contra spam: Máximo de 3 posts por dia
      allow create: if isAuthed() 
        && request.resource.data.usuarioId == request.auth.uid
        // Validação adicional de cota no cliente/funções para evitar spam agressivo
        && request.resource.data.legenda.size() < 1000;
        
      // Apenas o criador do post pode editar (legenda, fechar comentários anônimos) ou deletar
      allow update, delete: if isAuthed() && resource.data.usuarioId == request.auth.uid;

      // --- SUBCOLEÇÃO DE COMENTÁRIOS ---
      match /comentarios/{comentarioId} {
        // Leitura de comentários é livre para membros
        allow read: if isAuthed();
        
        // Comentários anônimos não salvam remetenteId (remetenteId == null) para proteção
        allow create: if isAuthed() && (
          request.resource.data.isAnonimo == false ? request.resource.data.usuarioId == request.auth.uid : request.resource.data.usuarioId == null
        );
        
        // Comentários não podem ser modificados para evitar falsificação
        allow update, delete: if false;
      }
    }

    // --- 3. COLEÇÃO DE CONVERSAS (conversas) ---
    match /conversas/{conversaId} {
      // Usuário só pode ler/escrever conversas nas quais ele é participante
      allow read, write: if isAuthed() && request.auth.uid in resource.data.participantes;
      allow create: if isAuthed() && request.auth.uid in request.resource.data.participantes;

      // --- SUBCOLEÇÃO DE MENSAGENS ---
      match /mensagens/{mensagemId} {
        // Participantes da conversa pai podem ler mensagens
        allow read: if isAuthed() && request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
        
        // Envio seguro de mensagens criptografadas no servidor
        allow create: if isAuthed() 
          && request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes
          && (request.resource.data.isAnonimo == true ? request.resource.data.remetenteId == null : request.resource.data.remetenteId == request.auth.uid);
      }
    }

    // --- 4. NOTIFICAÇÕES (notificacoes) ---
    match /notificacoes/{notifId} {
      // Apenas o destinatário lê suas notificações
      allow read: if isAuthed() && resource.data.usuarioId == request.auth.uid;
      // Qualquer usuário autenticado ou cloud function cria notificações ao interagir
      allow create: if isAuthed();
      // O destinatário pode marcar como lidas
      allow update: if isAuthed() && resource.data.usuarioId == request.auth.uid;
      allow delete: if false;
    }

    // --- 5. DENÚNCIAS (denuncias) ---
    match /denuncias/{denunciaId} {
      // Somente o denunciante cria denúncias
      allow create: if isAuthed() && request.resource.data.denuncianteId == request.auth.uid;
      // Apenas administradores do sistema têm acesso para ler e atualizar as denúncias
      allow read, update, delete: if false; 
    }
  }
}
